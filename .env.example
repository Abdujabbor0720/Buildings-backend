# ─────────────── Ilova ───────────────
NODE_ENV=development
PORT=3333
API_PREFIX=api/v1
# ⚠️ Frontend qaysi manzildan kelsa — AYNAN o‘sha. Vergul bilan bir
# nechta bo‘lishi mumkin.
#   lokal : http://localhost:4444
#   prod  : https://qurilish.mysrv.uz
# `http://` yoki oxirida `/` bilan yozilsa MOS KELMAYDI va brauzer har
# so‘rovni bloklaydi — server jurnalida esa xato ko‘rinmaydi.
CORS_ORIGINS=http://localhost:4444

# ─────────────── PostgreSQL ───────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=buildings
DB_PASSWORD=buildings
DB_NAME=buildings_db
DB_LOGGING=false
DB_SSL=false

# ─────────────── JWT ───────────────
# ⚠️ Prod'da ALBATTA almashtiring: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789
JWT_ACCESS_TTL=30m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789
JWT_REFRESH_TTL=30d

# ─────────────── Fayllar ───────────────
UPLOAD_MAX_MB=100

# ─────────────── Rate limit ───────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=200

# ─────────────── Fayl saqlash: DigitalOcean Spaces ───────────────
# ⚠️ Lokal `uploads/` papkasi YO‘Q. Fayllar obyekt xotirasida saqlanadi:
# bir nechta server nusxasi ishlaganda disk bo‘linmaydi va konteyner
# qayta yaratilganda ma’lumot yo‘qolmaydi.
DO_REGION=fra1
DO_ENDPOINT=fra1.digitaloceanspaces.com
DO_ACCESS_KEY=
DO_SECRET_KEY=
DO_BUCKET_NAME=
# Bucket ochiq bo‘lsa — CDN manzili. BO‘SH qoldirilsa bucket yopiq deb
# hisoblanadi va har so‘rovda imzolangan (muddatli) havola beriladi.
DO_BUCKET_PUBLIC_BASE_URL=
DO_SIGNED_URL_TTL=900

# ─────────────── AI (OpenAI) ───────────────
# Kalit bo‘sh bo‘lsa suratni AI tahlil qilish O‘CHADI (qoidalar dvigateli
# ishlayveradi) — tizim xato bermaydi, faqat tahlil «mavjud emas» bo‘ladi.
OPENAI_API_KEY=
AI_VISION_MODEL=gpt-5.4-mini
AI_VISION_ENABLED=true
AI_VISION_MAX_IMAGES=4
AI_VISION_TIMEOUT_MS=90000
